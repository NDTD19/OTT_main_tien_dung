generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================
// ENUMS
// ===================================================

enum Role {
  STUDENT
  JUDGE
  ADMIN
}

enum SubmissionStatus {
  STORED
  BUILDING
  READY
  REJECTED
}

enum MatchKind {
  DEMO
  PRACTICE
  OFFICIAL
}

enum MatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  SUBMISSIONS_CLOSED
  RUNNING
  COMPLETED
  ARCHIVED
}

enum MatchWinner {
  PLAYER_A
  PLAYER_B
  DRAW
}

enum ResultStatus {
  PENDING
  VERIFIED
  FINAL
  DISPUTED
}

// ===================================================
// USERS AND SESSIONS
// ===================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  submissions       Submission[]
  tournamentEntries TournamentEntry[]
  staffAssignments  TournamentStaff[]
  auditLogs         AuditLog[]
  resultHistories   ResultHistory[]
  createdMatches    Match[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ===================================================
// BOT SUBMISSIONS
// ===================================================

model Submission {
  id         String           @id @default(uuid())
  userId     String?
  filename   String
  language   String
  version    String
  sourcePath String
  sha256     String
  status     SubmissionStatus @default(STORED)
  createdAt  DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  matchesAsA        Match[]           @relation("MatchSubmissionA")
  matchesAsB        Match[]           @relation("MatchSubmissionB")
  tournamentEntries TournamentEntry[]
  practiceRating    PracticeRating?
  ratingEvents      RatingEvent[]

  @@index([userId, createdAt])
}

// ===================================================
// TOURNAMENT MANAGEMENT
// ===================================================

model Tournament {
  id        String           @id @default(uuid())
  name      String
  status    TournamentStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  entries TournamentEntry[]
  staff   TournamentStaff[]
  matches Match[]
}

model TournamentEntry {
  id                 String   @id @default(uuid())
  tournamentId       String
  userId             String
  lockedSubmissionId String?
  joinedAt           DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  user User @relation(fields: [userId], references: [id])

  lockedSubmission Submission? @relation(fields: [lockedSubmissionId], references: [id])

  @@unique([tournamentId, userId])
}

model TournamentStaff {
  id           String @id @default(uuid())
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

// ===================================================
// MATCHES
// ===================================================

model Match {
  id             String       @id @default(uuid())
  kind           MatchKind
  status         MatchStatus  @default(QUEUED)
  tournamentId   String?
  submissionAId  String?
  submissionBId  String?
  gameId         String
  rulesetVersion String
  rulesetHash    String?
  seed           String?
  winner         MatchWinner?
  resultStatus   ResultStatus @default(PENDING)
  reason         String?
  replayPath     String?
  replayHash     String?
  turnCount      Int?
  createdAt      DateTime     @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  legacyMetadata Json?

  createdById        String?
  maxMoves           Int?
  pieces             Int?
  firstPlayerSetting String?
  autoMatch          Boolean @default(false)

  creator User? @relation(fields: [createdById], references: [id])

  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  submissionA Submission? @relation("MatchSubmissionA", fields: [submissionAId], references: [id])

  submissionB Submission? @relation("MatchSubmissionB", fields: [submissionBId], references: [id])

  history       MatchHistory[]
  resultHistory ResultHistory[]
  ratingEvents  RatingEvent[]

  @@index([kind, status])
  @@index([tournamentId, status])
  @@index([createdAt])
}

model MatchHistory {
  id         String       @id @default(uuid())
  matchId    String
  sequence   Int
  fromStatus MatchStatus?
  toStatus   MatchStatus
  reason     String?
  createdAt  DateTime     @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, sequence])
}

model ResultHistory {
  id         String        @id @default(uuid())
  matchId    String
  fromStatus ResultStatus?
  toStatus   ResultStatus
  actorId    String?
  reason     String?
  createdAt  DateTime      @default(now())

  match Match @relation(fields: [matchId], references: [id])

  actor User? @relation(fields: [actorId], references: [id])

  @@index([matchId, createdAt])
}

// ===================================================
// PRACTICE RATING
// ===================================================

model PracticeRating {
  submissionId String @id
  elo          Int    @default(1200)
  wins         Int    @default(0)
  losses       Int    @default(0)
  draws        Int    @default(0)
  games        Int    @default(0)

  submission Submission @relation(fields: [submissionId], references: [id])
}

model RatingEvent {
  id           String   @id @default(uuid())
  matchId      String
  submissionId String
  delta        Int
  createdAt    DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  submission Submission @relation(fields: [submissionId], references: [id])

  @@unique([matchId, submissionId])
}

// ===================================================
// AUDIT LOG
// ===================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
}

model AppSetting {
  key   String @id
  value Json
}
